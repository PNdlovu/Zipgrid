# =============================================================
# Zipgrid AI Service — Environment Variables
# =============================================================
# Copy to .env and fill from 1Password → Zipgrid Vault → Development Secrets
# Never commit .env
# Last updated: September 30, 2026 (Planning Baseline v2.1)
# =============================================================


# -------------------------------------------------------------
# SERVER
# -------------------------------------------------------------
APP_ENV=development
# development | staging | production

PORT=8000
# FastAPI/uvicorn listens on http://localhost:8000

LOG_LEVEL=info
# debug | info | warning | error

ALLOWED_ORIGINS=http://localhost:3000
# Comma-separated list of allowed CORS origins
# Production: https://zipgrid.co.uk,https://www.zipgrid.co.uk

AI_SERVICE_SECRET=dev-ai-shared-secret-min-32-chars
# Must match AI_SERVICE_SECRET in apps/web/.env.local
# All requests from the platform API include this in X-Service-Secret header


# -------------------------------------------------------------
# OPENAI
# -------------------------------------------------------------
OPENAI_API_KEY=sk-
OPENAI_MODEL_INTENT=gpt-4o
# Model used for intent classification and entity extraction

OPENAI_MODEL_AGENT=gpt-4o
# Model used by the LangChain ZipgridAgent (all 3 modes)

OPENAI_MODEL_WHISPER=whisper-1
# Model used for audio transcription fallback

OPENAI_MAX_TOKENS_AGENT=2048
OPENAI_TEMPERATURE_AGENT=0.2
# Low temperature = consistent, predictable agentic actions


# -------------------------------------------------------------
# VECTOR DATABASE — PINECONE (RAG knowledge base)
# -------------------------------------------------------------
PINECONE_API_KEY=
PINECONE_INDEX_NAME=zipgrid-kb
PINECONE_ENVIRONMENT=eu-west1-gcp
# Must be an EU region to comply with UK GDPR adequacy requirements

PINECONE_TOP_K=5
# Number of RAG results to retrieve per knowledge base query


# -------------------------------------------------------------
# CACHE — UPSTASH REDIS
# Used for:
#   - Hot AI session store (TTL 1h, flushed to DB at session end)
#   - Agent task deduplication / idempotency keys
#   - Rate limiting inbound voice requests
# -------------------------------------------------------------
REDIS_URL=https://...upstash.io
REDIS_TOKEN=

AI_SESSION_TTL_SECONDS=3600
# Redis TTL for hot conversation context (1 hour)


# -------------------------------------------------------------
# DATABASE
# -------------------------------------------------------------
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/zipgrid_dev
# Used for: durable ai_sessions, agent_tasks, voice_commands audit log


# -------------------------------------------------------------
# AUTH — JWT
# -------------------------------------------------------------
JWT_SECRET=your-dev-jwt-secret-minimum-32-characters-long
# Must match JWT_SECRET in apps/web/.env.local
# All inbound requests are verified with this secret


# -------------------------------------------------------------
# PLATFORM API — WEB APP
# -------------------------------------------------------------
NEXTJS_API_URL=http://localhost:3000
# Used by AI tools to call platform domain APIs:
#   GET  /api/v1/listings/search
#   POST /api/v1/bookings
#   GET  /api/v1/sessions/:id
#   POST /api/v1/sessions/:id/stop
#   GET  /api/v1/wallet/balance
#   GET  /api/v1/chargers/:id/tariff


# -------------------------------------------------------------
# WAKE WORD DETECTION
# -------------------------------------------------------------
WAKE_WORD=hey zipgrid
# Case-insensitive trigger phrase for browser wake word detection

WAKE_WORD_CONFIDENCE_THRESHOLD=0.75
# Minimum Web Speech API confidence to trigger wake word


# -------------------------------------------------------------
# SAFETY GUARD
# -------------------------------------------------------------
SAFETY_BLOCK_PATTERNS=card number,sort code,cvv,passport,national insurance
# Comma-separated PII patterns — SafetyGuard redacts these from transcripts

SAFETY_MAX_PROMPT_LENGTH=2000
# Truncate user input beyond this length before sending to GPT


# -------------------------------------------------------------
# MONITORING — SENTRY
# -------------------------------------------------------------
SENTRY_DSN=https://...@o0.ingest.sentry.io/0
SENTRY_ENVIRONMENT=development


# -------------------------------------------------------------
# AGENT TASK SETTINGS
# -------------------------------------------------------------
AGENT_MAX_RETRIES=3
# Max retry attempts for failed agent_tasks before marking as 'failed'

AGENT_RETRY_BACKOFF_SECONDS=30
# Base backoff between retries (exponential: 30s, 60s, 120s)

FAULT_DIAGNOSIS_CONFIDENCE_THRESHOLD=0.70
# Minimum GPT confidence to auto-send RemoteReset without host confirmation

TARIFF_SCHEDULE_LOOKAHEAD_HOURS=24
# How far ahead to fetch Octopus Agile rates when scheduling smart charge
