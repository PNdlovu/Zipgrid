# =============================================================
# Zipgrid OCPP Service — Environment Variables
# =============================================================
# Copy to .env and fill from 1Password → Zipgrid Vault → Development Secrets
# Never commit .env
# Last updated: September 30, 2026 (Planning Baseline v2.1)
# =============================================================


# -------------------------------------------------------------
# SERVER
# -------------------------------------------------------------
NODE_ENV=development
# development | production

OCPP_PORT=3001
# WebSocket server listens on ws://localhost:3001/ocpp/:chargePointId

OCPP_SERVICE_SECRET=dev-ocpp-shared-secret-min-32-chars
# Must match OCPP_SERVICE_SECRET in apps/web/.env.local

LOG_LEVEL=info
# trace | debug | info | warn | error (pino logger)


# -------------------------------------------------------------
# DATABASE
# -------------------------------------------------------------
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/zipgrid_dev
# Direct write for session telemetry (meter values, OCPP event log).
# Uses postgres.js — no ORM.


# -------------------------------------------------------------
# CACHE / PRESENCE REGISTRY — UPSTASH REDIS
# -------------------------------------------------------------
REDIS_URL=https://...upstash.io
REDIS_TOKEN=
# Charger presence: key = cp:<chargePointId>, TTL 90s heartbeat
# Session state: key = session:<sessionId> for fast meter-value lookups


# -------------------------------------------------------------
# PLATFORM API — WEB APP
# -------------------------------------------------------------
NEXTJS_API_URL=http://localhost:3000
# Used by ChargerEventEmitter to call platform API routes:
#   POST /api/v1/sessions/start
#   POST /api/v1/sessions/meter-values
#   POST /api/v1/sessions/stop
#   POST /api/v1/chargers/fault


# -------------------------------------------------------------
# AUTH — JWT
# -------------------------------------------------------------
JWT_SECRET=your-dev-jwt-secret-minimum-32-characters-long
# Must match JWT_SECRET in apps/web/.env.local
# Used to verify inbound HTTP requests from the platform API


# -------------------------------------------------------------
# MONITORING — SENTRY
# -------------------------------------------------------------
SENTRY_DSN=https://...@o0.ingest.sentry.io/0
SENTRY_ENVIRONMENT=development


# -------------------------------------------------------------
# OCPP PROTOCOL SETTINGS
# (These are runtime configuration, not secrets — safe to commit defaults)
# -------------------------------------------------------------
OCPP_HEARTBEAT_INTERVAL_SECONDS=60
# How often chargers must send Heartbeat before marked offline

OCPP_SESSION_IDLE_TIMEOUT_SECONDS=300
# Max seconds of inactivity before session auto-terminated

OCPP_MAX_CONNECTIONS=500
# Max concurrent WebSocket connections (scale horizontally above this)

OCPP_SUPPORTED_PROTOCOLS=ocpp1.6,ocpp2.0.1
# Comma-separated list — service negotiates with charger on connect
