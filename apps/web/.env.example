# =============================================================
# Zipgrid Web App — Environment Variables
# =============================================================
# Copy to .env.local and fill from 1Password → Zipgrid Vault → Development Secrets
# Never commit .env.local
# Last updated: September 30, 2026 (Planning Baseline v2.1)
# =============================================================


# -------------------------------------------------------------
# APP
# -------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_ENV=development
# development | staging | production


# -------------------------------------------------------------
# DATABASE
# -------------------------------------------------------------
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/zipgrid_dev
# Railway eu-west in production — get from Railway dashboard


# -------------------------------------------------------------
# AUTH — JWT
# -------------------------------------------------------------
JWT_SECRET=your-dev-jwt-secret-minimum-32-characters-long
JWT_REFRESH_SECRET=your-dev-refresh-secret-minimum-32-characters-long
# Access token: 15 min TTL · Refresh token: 30 days TTL

# NextAuth (used only for OAuth callback URL resolution)
NEXTAUTH_SECRET=your-dev-nextauth-secret
NEXTAUTH_URL=http://localhost:3000

# OAuth providers
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=

# Phone verification (Twilio — code complete, keys needed in prod)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=


# -------------------------------------------------------------
# PAYMENTS — STRIPE
# -------------------------------------------------------------
STRIPE_SECRET_KEY=sk_test_
STRIPE_PUBLISHABLE_KEY=pk_test_
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_
STRIPE_WEBHOOK_SECRET=whsec_

# Stripe Connect (host payouts)
STRIPE_CONNECT_CLIENT_ID=ca_

# Stripe Identity (KYC)
# Uses STRIPE_SECRET_KEY — no additional key required

# Driver Plus subscription price IDs (create in Stripe dashboard)
STRIPE_PRICE_DRIVER_PLUS_MONTHLY=price_
STRIPE_PRICE_DRIVER_PLUS_ANNUAL=price_


# -------------------------------------------------------------
# MAPS — MAPBOX
# -------------------------------------------------------------
NEXT_PUBLIC_MAPBOX_TOKEN=pk.eyJ1IjoiemlwZ3JpZCIsImEiOiJ...


# -------------------------------------------------------------
# AI / OPENAI
# -------------------------------------------------------------
OPENAI_API_KEY=sk-


# -------------------------------------------------------------
# VECTOR DATABASE — PINECONE (RAG knowledge base)
# -------------------------------------------------------------
PINECONE_API_KEY=
PINECONE_INDEX_NAME=zipgrid-kb
PINECONE_ENVIRONMENT=eu-west1-gcp


# -------------------------------------------------------------
# REALTIME — SUPABASE
# Used for live session updates and presence.
# Polling fallback is active — Supabase Realtime is an upgrade path.
# -------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=


# -------------------------------------------------------------
# CACHE / RATE-LIMITING — UPSTASH REDIS
# -------------------------------------------------------------
UPSTASH_REDIS_URL=https://...upstash.io
UPSTASH_REDIS_TOKEN=
# Also used by OCPP service for charger presence registry


# -------------------------------------------------------------
# EMAIL — RESEND
# Used for: OTP verification, booking confirmations, receipts,
# password reset, notifications digest
# -------------------------------------------------------------
RESEND_API_KEY=re_
RESEND_FROM_EMAIL=noreply@zipgrid.co.uk
RESEND_REPLY_TO=support@zipgrid.co.uk


# -------------------------------------------------------------
# PUSH NOTIFICATIONS — FIREBASE (FCM)
# -------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_PRIVATE_KEY=
FIREBASE_ADMIN_CLIENT_EMAIL=


# -------------------------------------------------------------
# GRID CARBON INTENSITY API
# Used by SessionService to record CO2e data per session.
# UK: National Grid ESO Carbon Intensity API (free, no key needed)
# EU (future): ENTSO-E Transparency Platform
# -------------------------------------------------------------
CARBON_INTENSITY_API_URL=https://api.carbonintensity.org.uk
# No API key required for UK Carbon Intensity API
# ENTSO_E_API_KEY=   (EU expansion — Month 30+)


# -------------------------------------------------------------
# INTERNAL SERVICES
# -------------------------------------------------------------
OCPP_SERVICE_URL=http://localhost:3001
OCPP_SERVICE_SECRET=dev-ocpp-shared-secret-min-32-chars

AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_SECRET=dev-ai-shared-secret-min-32-chars

# Internal cron auth (pg_cron jobs call the API)
CRON_SECRET=dev-cron-secret-min-32-chars


# -------------------------------------------------------------
# MONITORING — SENTRY
# -------------------------------------------------------------
NEXT_PUBLIC_SENTRY_DSN=https://...@o0.ingest.sentry.io/0
SENTRY_ORG=zipgrid
SENTRY_PROJECT=zipgrid-web
SENTRY_AUTH_TOKEN=
# SENTRY_ENVIRONMENT is set automatically from NEXT_PUBLIC_APP_ENV


# -------------------------------------------------------------
# ANALYTICS — POSTHOG
# EU data residency: eu.posthog.com
# -------------------------------------------------------------
NEXT_PUBLIC_POSTHOG_KEY=phc_
NEXT_PUBLIC_POSTHOG_HOST=https://eu.posthog.com


# -------------------------------------------------------------
# CONTENT — CONTENTLAYER / BLOG
# No external keys required — Contentlayer reads from /content
# MDX files are built at compile time.
# -------------------------------------------------------------


# -------------------------------------------------------------
# FEATURE FLAGS
# Set to 'true' to enable in this environment.
# All Phase 1 features are enabled by default.
# Phase 2+ features are gated until deployment readiness confirmed.
# -------------------------------------------------------------

# Phase 1 — always on
NEXT_PUBLIC_FEATURE_AUTH=true
NEXT_PUBLIC_FEATURE_LISTINGS=true
NEXT_PUBLIC_FEATURE_BOOKINGS=true
NEXT_PUBLIC_FEATURE_SESSIONS=true
NEXT_PUBLIC_FEATURE_PAYMENTS=true
NEXT_PUBLIC_FEATURE_VOICE=true
NEXT_PUBLIC_FEATURE_AGENTIC_AI=true
NEXT_PUBLIC_FEATURE_HOST_DASHBOARD=true

# Phase 2 — enable when service accounts are ready
NEXT_PUBLIC_FEATURE_WALLET=false
NEXT_PUBLIC_FEATURE_REWARDS=false
NEXT_PUBLIC_FEATURE_EMERGENCY=false
NEXT_PUBLIC_FEATURE_FLEET=false
NEXT_PUBLIC_FEATURE_SMB_PORTAL=false
NEXT_PUBLIC_FEATURE_MARKETPLACE=false

# Phase 3 — enable when Phase 3 is deployed
NEXT_PUBLIC_FEATURE_COMMUNITY=false
NEXT_PUBLIC_FEATURE_PARKING=false
NEXT_PUBLIC_FEATURE_ESG_REPORTS=false
NEXT_PUBLIC_FEATURE_DRIVER_PLUS=false
NEXT_PUBLIC_FEATURE_WHITE_LABEL=false

# Phase 4 — EU expansion + V2G
NEXT_PUBLIC_FEATURE_V2G=false
NEXT_PUBLIC_FEATURE_OCPI_ROAMING=false
NEXT_PUBLIC_FEATURE_EU_EXPANSION=false


# -------------------------------------------------------------
# GDPR / DATA EXPORT
# Used by GdprService for Subject Access Requests and right-to-erasure.
# No external keys — uses DATABASE_URL + RESEND_API_KEY.
# -------------------------------------------------------------


# -------------------------------------------------------------
# PARTNERSHIPS (Phase 3+)
# -------------------------------------------------------------
# Zap-Map OCPI integration
# ZAP_MAP_OCPI_TOKEN=

# Google Actions / Alexa skill webhook secret
# PARTNER_WEBHOOK_SECRET=
