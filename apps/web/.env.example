# Zipgrid Web App — Environment Variables
# Copy to .env.local and fill from 1Password → Zipgrid Vault → Development Secrets
# Never commit .env.local

# Database
DATABASE_URL=

# Auth
JWT_SECRET=
JWT_REFRESH_SECRET=
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Payments
STRIPE_SECRET_KEY=sk_test_
STRIPE_PUBLISHABLE_KEY=pk_test_
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_
STRIPE_WEBHOOK_SECRET=whsec_

# Maps
NEXT_PUBLIC_MAPBOX_TOKEN=

# AI
OPENAI_API_KEY=

# Realtime
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Cache
UPSTASH_REDIS_URL=
UPSTASH_REDIS_TOKEN=

# Push notifications
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
FIREBASE_ADMIN_PRIVATE_KEY=
FIREBASE_ADMIN_CLIENT_EMAIL=

# Services
OCPP_SERVICE_URL=http://localhost:3001
OCPP_SERVICE_SECRET=
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_SECRET=

# Monitoring
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.posthog.com

# Feature flags (set to false to hide unreleased features)
NEXT_PUBLIC_FEATURE_WALLET=false
NEXT_PUBLIC_FEATURE_REWARDS=false
NEXT_PUBLIC_FEATURE_COMMUNITY=false
