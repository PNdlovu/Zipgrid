{
  "extends": [
    "next/core-web-vitals",
    "../../.eslintrc.base.json"
  ],
  "rules": {
    "@typescript-eslint/no-explicit-any": "error",
    "no-restricted-imports": [
      "error",
      {
        "patterns": [
          {
            "group": ["../domains/*/internal/*"],
            "message": "Do not import from a domain's internal files. Use the domain's public index.ts instead."
          }
        ]
      }
    ]
  }
}
